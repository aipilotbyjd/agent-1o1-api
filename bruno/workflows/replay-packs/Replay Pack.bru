meta {
  name: Replay Pack
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/workflows/:workflow/replay-packs/:replayPack/replay
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  workflow: 1
  replayPack: 1
}

headers {
  Accept: application/json
}

docs {
  Starts a new run from a saved replay pack's snapshotted graph and trigger data.
  Requires the `run.replay-pack.manage` permission.

  Expected result:
  - 201 with the created run, including its `steps`.
  - 403 if the user lacks the `run.replay-pack.manage` permission.
  - 404 if the replay pack doesn't belong to this workflow.
}

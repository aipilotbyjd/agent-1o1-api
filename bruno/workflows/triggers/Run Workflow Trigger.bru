meta {
  name: Run Workflow Trigger
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/workflows/:workflow/triggers/:trigger/run
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  workflow: 1
  trigger: 1
}

headers {
  Accept: application/json
}

docs {
  Manually fires the trigger, starting a run of the target workflow. Requires the
  `trigger.run` permission.

  Expected result:
  - 202 with { event_id } once the run has been queued. The run is started by a
    queue worker, so poll the trigger's events endpoint for its status and run_id.
  - 409 if a run is already in progress for this trigger's target, or the target isn't
    currently runnable.
  - 403 if the user lacks the `trigger.run` permission.
  - 404 if the trigger doesn't belong to this workflow.
}

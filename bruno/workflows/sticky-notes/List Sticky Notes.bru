meta {
  name: List Sticky Notes
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/workflows/:workflow/sticky-notes
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  workflow: 1
}

headers {
  Accept: application/json
}

docs {
  Lists the workflow's sticky notes, ordered by z_index. Requires the `workflow.view`
  permission.

  Expected result:
  - 200 with an array of sticky notes.
  - 403 if the user lacks the `workflow.view` permission.
  - 404 if the workflow doesn't belong to this workspace.
}

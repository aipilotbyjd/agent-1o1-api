meta {
  name: Create Tag
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/tags
  body: json
  auth: inherit
}

params:path {
  workspace: 1
}

headers {
  Accept: application/json
}

body:json {
  {
    "name": "critical",
    "color": "#ef4444"
  }
}

script:post-response {
  if (res.body?.data?.id) {
    bru.setVar("tagId", res.body.data.id);
  }
}

docs {
  Creates a new tag in the workspace. `name` is required (max 100 chars, must be
  unique within the workspace); `color` (hex) is optional. Requires the
  `workflow.manage` permission.

  Expected result:
  - 201 with the created tag.
  - 422 if a tag with this name already exists.
  - 403 if the user lacks the `workflow.manage` permission.
}

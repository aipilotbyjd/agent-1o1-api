meta {
  name: Delete Tag
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/tags/:tag
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  tag: 1
}

headers {
  Accept: application/json
}

docs {
  Deletes a tag. The tag is automatically removed from all workflows. Requires the
  `workflow.manage` permission.

  Expected result:
  - 200 on success.
  - 403 if the user lacks the `workflow.manage` permission.
  - 404 if the tag doesn't belong to this workspace.
}

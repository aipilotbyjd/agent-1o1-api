meta {
  name: Create Workflow
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/workflows
  body: json
  auth: inherit
}

params:path {
  workspace: 1
}

headers {
  Accept: application/json
}

body:json {
  {
    "name": "Lead Enrichment",
    "description": "Enriches inbound leads and routes them to the right agent."
  }
}

script:post-response {
  if (res.body?.data?.id) {
    bru.setVar("workflowId", res.body.data.id);
  }
}

docs {
  Creates an empty workflow (no steps/edges yet) in the workspace. A unique slug is
  auto-generated from `name`. Requires the `workflow.manage` permission. Use "Save
  Workflow Graph" afterwards to add steps and edges.

  Expected result:
  - 201 with the created workflow.
  - 422 on validation errors.
  - 403 if the user lacks the `workflow.manage` permission.
}

meta {
  name: Reject Workflow Approval
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/workflows/:workflow/approvals/:approval/reject
  body: json
  auth: inherit
}

params:path {
  workspace: 1
  workflow: 1
  approval: 1
}

headers {
  Accept: application/json
}

body:json {
  {
    "notes": "Needs another pass on error handling before this can ship."
  }
}

docs {
  Rejects a pending approval request. `notes` is optional. Only valid while the
  approval's `status` is `pending`. Requires the `workflow.approval.review`
  permission.

  Expected result:
  - 200 with the updated approval (status `rejected`).
  - 200-shaped error (`ApiResponse::error`) if the approval was already reviewed.
  - 403 if the user lacks the `workflow.approval.review` permission.
  - 404 if the approval doesn't belong to this workflow.
}

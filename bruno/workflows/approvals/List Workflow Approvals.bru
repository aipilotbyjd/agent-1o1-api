meta {
  name: List Workflow Approvals
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/workflows/:workflow/approvals
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  workflow: 1
}

headers {
  Accept: application/json
}

docs {
  Lists the workflow's approval requests, most recently requested first. Requires the
  `workflow.approval.view` permission.

  Expected result:
  - 200 with an array of approvals.
  - 403 if the user lacks the `workflow.approval.view` permission.
  - 404 if the workflow doesn't belong to this workspace.
}

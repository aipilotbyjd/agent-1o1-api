meta {
  name: List Workflow Versions
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/workflows/:workflow/versions
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  workflow: 1
}

headers {
  Accept: application/json
}

docs {
  Lists the workflow's published versions, newest first. Each entry omits its `graph`
  payload (`include_graph` is disabled) — use "Get Workflow Version" for the full
  graph. Requires the `workflow.version.view` permission.

  Expected result:
  - 200 with an array of versions.
  - 403 if the user lacks the `workflow.version.view` permission.
  - 404 if the workflow doesn't belong to this workspace.
}

meta {
  name: Delete Workflow
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/workflows/:workflow
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  workflow: 1
}

headers {
  Accept: application/json
}

docs {
  Deletes a workflow. Requires the `workflow.manage` permission.

  Expected result:
  - 200 on success.
  - 403 if the user lacks the `workflow.manage` permission.
  - 404 if the workflow doesn't belong to this workspace.
}

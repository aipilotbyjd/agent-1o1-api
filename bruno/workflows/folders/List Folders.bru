meta {
  name: List Folders
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/folders
  body: none
  auth: inherit
}

params:path {
  workspace: 1
}

headers {
  Accept: application/json
}

docs {
  Lists the workspace's folder tree, with root-level folders loaded recursively
  (`children`), and each folder's `workflows_count`. Requires the `workflow.view`
  permission.

  Expected result:
  - 200 with an array of folders.
  - 403 if the user lacks the `workflow.view` permission.
}

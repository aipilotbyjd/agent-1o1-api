meta {
  name: Create Contract Test Run
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/workflows/:workflow/contract-snapshots/:snapshot/test-runs
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  workflow: 1
  snapshot: 1
}

headers {
  Accept: application/json
}

docs {
  Runs a contract test: diffs the snapshot's stored `node_signature` against the
  workflow's current node signature and records the result. No request body — the
  `status` (`passed`/`failed`) and `results` are computed server-side by
  `ContractGenerator::diff()`. Requires the `workflow.contract-test-run.manage`
  permission.

  Expected result:
  - 201 with the created test run, including `status` and `results`.
  - 403 if the user lacks the `workflow.contract-test-run.manage` permission.
  - 404 if the snapshot doesn't belong to this workflow.
}

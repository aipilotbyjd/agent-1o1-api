meta {
  name: List Workflow Shares
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/workflows/:workflow/shares
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  workflow: 1
}

headers {
  Accept: application/json
}

docs {
  Lists the workflow's share links, most recently created first. Requires the
  `workflow.share.view` permission.

  Expected result:
  - 200 with an array of shares.
  - 403 if the user lacks the `workflow.share.view` permission.
  - 404 if the workflow doesn't belong to this workspace.
}

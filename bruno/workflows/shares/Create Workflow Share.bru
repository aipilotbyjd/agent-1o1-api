meta {
  name: Create Workflow Share
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/workflows/:workflow/shares
  body: json
  auth: inherit
}

params:path {
  workspace: 1
  workflow: 1
}

headers {
  Accept: application/json
}

body:json {
  {
    "allow_clone": true,
    "expires_at": "2026-08-28T00:00:00Z"
  }
}

script:post-response {
  if (res.body?.data?.id) {
    bru.setVar("workflowShareId", res.body.data.id);
  }
  if (res.body?.data?.token) {
    bru.setVar("workflowShareToken", res.body.data.token);
  }
}

docs {
  Creates a share link (a random 40-character token) for the workflow's published
  graph. `allow_clone` defaults to false when omitted; `expires_at`, if given, must be
  a future date. See "Clone Shared Workflow" for how the token is consumed. Requires
  the `workflow.share.manage` permission.

  Expected result:
  - 201 with the created share, including `token`.
  - 422 on validation errors (e.g. `expires_at` in the past).
  - 403 if the user lacks the `workflow.share.manage` permission.
  - 404 if the workflow doesn't belong to this workspace.
}

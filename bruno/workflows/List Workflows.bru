meta {
  name: List Workflows
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/workflows
  body: none
  auth: inherit
}

params:path {
  workspace: 1
}

headers {
  Accept: application/json
}

docs {
  Lists the workspace's workflows, most recently created first. Requires the
  `workflow.view` permission.

  Expected result:
  - 200 with an array of workflows.
  - 403 if the user lacks the `workflow.view` permission.
}

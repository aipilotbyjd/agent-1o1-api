meta {
  name: Create Agent Skill
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/agent-skills
  body: json
  auth: inherit
}

params:path {
  workspace: 1
}

headers {
  Accept: application/json
}

body:json {
  {
    "name": "Order Lookup",
    "description": "Looks up order status and details for a customer.",
    "category": "support",
    "icon": "package",
    "color": "#4f46e5",
    "tags": ["orders", "support"],
    "instructions": "Given an order number, look up its current status and summarize it clearly.",
    "is_shared": false
  }
}

script:post-response {
  if (res.body?.data?.id) {
    bru.setVar("skillId", res.body.data.id);
  }
}

docs {
  Creates an agent skill in the workspace. `slug` is optional — it's derived from `name`
  when omitted, and must be unique within the workspace. Requires the
  `agent-skill.manage` permission.

  Expected result:
  - 201 with the created skill.
  - 422 on validation errors (e.g. slug already taken).
  - 403 if the user lacks the `agent-skill.manage` permission.
}

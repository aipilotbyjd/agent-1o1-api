meta {
  name: List Skill Scripts
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/agent-skills/:skill/scripts
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  skill: 1
}

headers {
  Accept: application/json
}

docs {
  Lists the skill's scripts. Requires the `agent-skill-script.view` permission.

  Expected result:
  - 200 with an array of scripts.
  - 403 if the user lacks the `agent-skill-script.view` permission.
  - 404 if the skill doesn't belong to this workspace.
}

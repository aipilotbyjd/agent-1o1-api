meta {
  name: Delete Skill Script
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/agent-skills/:skill/scripts/:script
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  skill: 1
  script: 1
}

headers {
  Accept: application/json
}

docs {
  Deletes a skill script. Requires the `agent-skill-script.manage` permission.

  Expected result:
  - 200 on success.
  - 403 if the user lacks the `agent-skill-script.manage` permission.
  - 404 if the script doesn't belong to this skill.
}

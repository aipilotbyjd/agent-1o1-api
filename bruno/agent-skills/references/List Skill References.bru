meta {
  name: List Skill References
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/agent-skills/:skill/references
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  skill: 1
}

headers {
  Accept: application/json
}

docs {
  Lists the skill's reference documents, ordered by `sort_order`. Requires the
  `agent-skill-reference.view` permission.

  Expected result:
  - 200 with an array of references.
  - 403 if the user lacks the `agent-skill-reference.view` permission.
  - 404 if the skill doesn't belong to this workspace.
}

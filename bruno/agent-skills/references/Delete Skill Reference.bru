meta {
  name: Delete Skill Reference
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/agent-skills/:skill/references/:reference
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  skill: 1
  reference: 1
}

headers {
  Accept: application/json
}

docs {
  Deletes a skill reference. Requires the `agent-skill-reference.manage` permission.

  Expected result:
  - 200 on success.
  - 403 if the user lacks the `agent-skill-reference.manage` permission.
  - 404 if the reference doesn't belong to this skill.
}

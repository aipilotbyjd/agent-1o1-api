meta {
  name: Create Workflow Builder Session
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/workflow-builder-sessions
  body: json
  auth: inherit
}

params:path {
  workspace: 1
}

headers {
  Accept: application/json
}

body:json {
  {
    "workflow_id": null,
    "title": "New lead onboarding flow"
  }
}

docs {
  Creates a workflow builder session for the authenticated user. `workflow_id` is
  optional — pass an existing workspace workflow id to continue editing it, or omit
  it to start a fresh draft (`draft_graph` starts empty). Requires the
  `workflow.builder.use` permission.

  Expected result:
  - 201 with the created session.
  - 422 on validation errors (e.g. `workflow_id` not in this workspace).
  - 403 if the user lacks the `workflow.builder.use` permission.
}

meta {
  name: Get Workflow Builder Session
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/workflow-builder-sessions/:session
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  session: 1
}

headers {
  Accept: application/json
}

docs {
  Shows a single workflow builder session by id, with a message count. A regular
  member may only view their own sessions; owner/admin (with `workflow.manage`) may
  view any session in the workspace.

  Expected result:
  - 200 with the session.
  - 403 if the session belongs to another user and the caller lacks `workflow.manage`.
  - 404 if the session doesn't belong to this workspace.
}

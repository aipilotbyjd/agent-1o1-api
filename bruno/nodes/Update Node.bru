meta {
  name: Update Node
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/nodes/:node
  body: json
  auth: inherit
}

params:path {
  workspace: 1
  node: 1
}

headers {
  Accept: application/json
}

body:json {
  {
    "name": "Send Slack Message (v2)",
    "description": "Posts a message to a Slack channel, with retry support."
  }
}

docs {
  Updates a custom node. Only nodes with `is_custom = true` can be modified — builtin
  catalog nodes are read-only.

  Expected result:
  - 200 with the updated node.
  - 422 on validation errors.
  - 403 if the node is a builtin catalog node.
  - 404 if the node belongs to a different workspace.
}

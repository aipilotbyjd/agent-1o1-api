meta {
  name: List Nodes
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/nodes
  body: none
  auth: inherit
}

params:path {
  workspace: 1
}

headers {
  Accept: application/json
}

docs {
  Lists the builtin node catalog plus this workspace's custom nodes, ordered by name.
  Supports an optional `?category_id=` filter. Requires the `node.view` permission.

  Expected result:
  - 200 with the list of nodes.
  - 403 if the user lacks the `node.view` permission.
}

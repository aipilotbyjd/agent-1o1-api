meta {
  name: Delete Tool
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/tools/:tool
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  tool: 1
}

headers {
  Accept: application/json
}

docs {
  Deletes a tool. Requires the `tool.manage` permission.

  Expected result:
  - 200 on success.
  - 403 if the user lacks the `tool.manage` permission.
  - 404 if the tool doesn't belong to this workspace.
}

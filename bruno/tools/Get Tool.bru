meta {
  name: Get Tool
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/tools/:tool
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  tool: 1
}

headers {
  Accept: application/json
}

docs {
  Shows a single tool by id. Requires the `tool.view` permission.

  Expected result:
  - 200 with the tool.
  - 403 if the user lacks the `tool.view` permission.
  - 404 if the tool doesn't belong to this workspace.
}

meta {
  name: Update Tool
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/tools/:tool
  body: json
  auth: inherit
}

params:path {
  workspace: 1
  tool: 1
}

headers {
  Accept: application/json
}

body:json {
  {
    "description": "Fetches current weather for a city, with metric units.",
    "config": {
      "url": "https://api.example.com/weather",
      "method": "GET",
      "timeout": 15
    }
  }
}

docs {
  Updates a tool. No explicit permission check beyond workspace membership on this
  action.

  Expected result:
  - 200 with the updated tool.
  - 422 on validation errors.
  - 404 if the tool doesn't belong to this workspace.
}

meta {
  name: List Runs
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/runs
  body: none
  auth: inherit
}

params:path {
  workspace: 1
}

headers {
  Accept: application/json
}

docs {
  Lists runs for the workspace, newest first. Supports an optional `status` query filter
  and `per_page` (capped at 100, defaults to 25). Requires the `run.view` permission.

  Expected result:
  - 200 with a paginated list of runs.
  - 403 if the authenticated user lacks the `run.view` permission.
}

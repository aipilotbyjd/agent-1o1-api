meta {
  name: List Run Fix Suggestions
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/runs/:run/fix-suggestions
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  run: 1
}

headers {
  Accept: application/json
}

docs {
  Lists AI-generated fix suggestions for a failed workflow run, most recent first.
  Requires the `run.view` permission.

  Expected result:
  - 200 with an array of fix suggestions.
  - 403 if the user lacks the `run.view` permission.
  - 404 if the run doesn't belong to this workspace.
}

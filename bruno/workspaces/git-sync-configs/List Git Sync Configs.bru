meta {
  name: List Git Sync Configs
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/git-sync-configs
  body: none
  auth: inherit
}

params:path {
  workspace: 1
}

headers {
  Accept: application/json
}

docs {
  Lists the workspace's git sync configs. Requires the `git-sync.view` permission.

  Expected result:
  - 200 with a list of git sync configs.
  - 403 if the authenticated user lacks the `git-sync.view` permission.
}

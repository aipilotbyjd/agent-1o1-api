meta {
  name: Sync Git Sync Config
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/git-sync-configs/:gitSyncConfig/sync
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  gitSyncConfig: 1
}

headers {
  Accept: application/json
}

docs {
  Queues a job to sync the workspace's workflows to the configured git repository.
  Requires the `git-sync.manage` permission.

  Expected result:
  - 200 once the sync job has been queued.
  - 403 if the authenticated user lacks the `git-sync.manage` permission.
  - 404 if the config doesn't belong to this workspace.
}

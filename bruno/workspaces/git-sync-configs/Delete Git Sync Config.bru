meta {
  name: Delete Git Sync Config
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/git-sync-configs/:gitSyncConfig
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  gitSyncConfig: 1
}

headers {
  Accept: application/json
}

docs {
  Deletes a git sync config. Requires the `git-sync.manage` permission.

  Expected result:
  - 200 on success.
  - 403 if the authenticated user lacks the `git-sync.manage` permission.
  - 404 if the config doesn't belong to this workspace.
}

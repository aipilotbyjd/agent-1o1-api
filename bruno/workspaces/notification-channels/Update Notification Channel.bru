meta {
  name: Update Notification Channel
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/notification-channels/:notificationChannel
  body: json
  auth: inherit
}

params:path {
  workspace: 1
  notificationChannel: 1
}

headers {
  Accept: application/json
}

body:json {
  {
    "name": "Ops Webhook (updated)",
    "is_active": false
  }
}

docs {
  Updates a notification channel. All fields are optional; if `config` is provided it must
  include `config.url`. Requires the `notification-channel.manage` permission.

  Expected result:
  - 200 with the updated notification channel.
  - 422 on validation errors.
  - 403 if the authenticated user lacks the `notification-channel.manage` permission.
  - 404 if the channel doesn't belong to this workspace.
}

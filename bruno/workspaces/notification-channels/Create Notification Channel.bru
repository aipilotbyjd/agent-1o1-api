meta {
  name: Create Notification Channel
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/notification-channels
  body: json
  auth: inherit
}

params:path {
  workspace: 1
}

headers {
  Accept: application/json
}

body:json {
  {
    "type": "webhook",
    "name": "Ops Webhook",
    "config": {
      "url": "https://example.com/webhooks/notifications",
      "headers": {
        "X-Example": "placeholder"
      }
    },
    "is_active": true
  }
}

docs {
  Creates a notification channel. `type` must be one of `discord`, `slack`, or `webhook`,
  and `config.url` is required. `is_active` defaults to `true` when omitted. Requires the
  `notification-channel.manage` permission.

  Expected result:
  - 201 with the created notification channel.
  - 422 on validation errors (e.g. invalid `type` or missing `config.url`).
  - 403 if the authenticated user lacks the `notification-channel.manage` permission.
}

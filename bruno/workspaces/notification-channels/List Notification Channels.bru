meta {
  name: List Notification Channels
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/notification-channels
  body: none
  auth: inherit
}

params:path {
  workspace: 1
}

headers {
  Accept: application/json
}

docs {
  Lists the workspace's notification channels, newest first. Requires the
  `notification-channel.view` permission.

  Expected result:
  - 200 with a list of notification channels.
  - 403 if the authenticated user lacks the `notification-channel.view` permission.
}

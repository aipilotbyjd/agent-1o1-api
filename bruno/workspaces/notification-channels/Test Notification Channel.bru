meta {
  name: Test Notification Channel
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/notification-channels/:notificationChannel/test
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  notificationChannel: 1
}

headers {
  Accept: application/json
}

docs {
  Sends a test notification through the channel to verify its configuration works.
  Requires the `notification-channel.manage` permission.

  Expected result:
  - 200 if the test delivery succeeded.
  - 400 if the test delivery failed (e.g. webhook endpoint unreachable).
  - 403 if the authenticated user lacks the `notification-channel.manage` permission.
  - 404 if the channel doesn't belong to this workspace.
}

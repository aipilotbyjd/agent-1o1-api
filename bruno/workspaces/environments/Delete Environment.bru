meta {
  name: Delete Environment
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/environments/:environment
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  environment: 1
}

headers {
  Accept: application/json
}

docs {
  Deletes a workspace environment. Requires the `environment.manage` permission.

  Expected result:
  - 200 on success.
  - 403 if the authenticated user lacks the `environment.manage` permission.
  - 404 if the environment doesn't belong to this workspace.
}

meta {
  name: List Environments
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/environments
  body: none
  auth: inherit
}

params:path {
  workspace: 1
}

headers {
  Accept: application/json
}

docs {
  Lists the workspace's environments, ordered by name. Requires the `environment.view`
  permission.

  Expected result:
  - 200 with a list of environments.
  - 403 if the authenticated user lacks the `environment.view` permission.
}

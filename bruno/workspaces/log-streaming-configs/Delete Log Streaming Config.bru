meta {
  name: Delete Log Streaming Config
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/log-streaming-configs/:logStreamingConfig
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  logStreamingConfig: 1
}

headers {
  Accept: application/json
}

docs {
  Deletes a log streaming config, stopping log delivery to that destination.
  Requires the `workspace.update` permission.

  Expected result:
  - 200 on success.
  - 403 if the user lacks the `workspace.update` permission.
  - 404 if the config doesn't belong to this workspace.
}

meta {
  name: Update Log Streaming Config
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/log-streaming-configs/:logStreamingConfig
  body: json
  auth: inherit
}

params:path {
  workspace: 1
  logStreamingConfig: 1
}

headers {
  Accept: application/json
}

body:json {
  {
    "endpoint": "https://logs-v2.example.com/ingest",
    "is_active": false
  }
}

docs {
  Updates a log streaming config's destination, endpoint, headers, and/or is_active
  flag. Requires the `workspace.update` permission.

  Expected result:
  - 200 with the updated config.
  - 422 on validation errors.
  - 403 if the user lacks the `workspace.update` permission.
  - 404 if the config doesn't belong to this workspace.
}

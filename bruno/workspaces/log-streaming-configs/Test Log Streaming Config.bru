meta {
  name: Test Log Streaming Config
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/log-streaming-configs/:logStreamingConfig/test
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  logStreamingConfig: 1
}

headers {
  Accept: application/json
}

docs {
  Sends a test payload to the log streaming config's endpoint to verify connectivity.
  Updates `last_delivered_at` on success. Requires the `workspace.update` permission.

  Expected result:
  - 200 with a success message.
  - 502 if the destination is unreachable or responds with an error.
  - 403 if the user lacks the `workspace.update` permission.
  - 404 if the config doesn't belong to this workspace.
}

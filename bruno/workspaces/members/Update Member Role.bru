meta {
  name: Update Member Role
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/members/:member
  body: json
  auth: inherit
}

params:path {
  workspace: 1
  member: 1
}

headers {
  Accept: application/json
}

body:json {
  {
    "role": "admin"
  }
}

docs {
  Updates a member's role to `admin` or `member`. Requires the authenticated user to be
  the workspace's `owner` or `admin`. The workspace `owner`'s own role can never be
  changed through this endpoint.

  Expected result:
  - 200 with the updated member.
  - 422 if targeting the workspace owner's membership.
  - 403 if the authenticated user is a regular `member`.
  - 404 if the member doesn't belong to this workspace.
}

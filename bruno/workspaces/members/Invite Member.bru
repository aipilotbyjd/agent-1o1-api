meta {
  name: Invite Member
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/members/invite
  body: json
  auth: inherit
}

params:path {
  workspace: 1
}

headers {
  Accept: application/json
}

body:json {
  {
    "email": "invitaee@example.com",
    "role": "member"
  }
}

docs {
  Invites a user by email to join the workspace with the given role (`admin` or `member`).
  Requires the authenticated user to be the workspace's `owner` or `admin`. Queues an
  invitation email containing a signed accept link — see "Accept Invitation".
  
  Expected result:
  - 201 with { email, role }.
  - 422 if the email already belongs to a member of the workspace.
  - 403 if the authenticated user is a regular `member`.
}

meta {
  name: Delete Workspace
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/v1/workspaces/:workspace
  body: none
  auth: inherit
}

params:path {
  workspace: 1
}

headers {
  Accept: application/json
}

docs {
  Deletes a workspace and cascades its members/invitations. Only the workspace's `owner`
  may do this — even an `admin` member is forbidden.

  Expected result:
  - 200 on success.
  - 403 if the authenticated user is not the workspace owner.
}

meta {
  name: Sync Agent Skills
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/agents/:agent/skills
  body: json
  auth: inherit
}

params:path {
  workspace: 1
  agent: 1
}

headers {
  Accept: application/json
}

body:json {
  {
    "skill_ids": [1, 2]
  }
}

docs {
  Replaces the agent's attached skills with the given set (pass `skill_ids: []` to detach
  all). Every id must belong to an agent skill in this workspace. Requires the
  `agent.skills.sync` permission.

  Expected result:
  - 200 with the agent's updated skills.
  - 422 if any `skill_id` doesn't exist in this workspace.
  - 403 if the user lacks the `agent.skills.sync` permission.
}

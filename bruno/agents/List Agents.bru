meta {
  name: List Agents
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/agents
  body: none
  auth: inherit
}

params:path {
  workspace: 1
}

headers {
  Accept: application/json
}

docs {
  Lists all agents in the workspace, most recently created first. Requires the
  `agent.view` permission.

  Expected result:
  - 200 with an array of agents.
  - 403 if the user lacks the `agent.view` permission.
}

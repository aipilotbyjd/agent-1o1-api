meta {
  name: Create Agent Trigger
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/agents/:agent/triggers
  body: json
  auth: inherit
}

params:path {
  workspace: 1
  agent: 1
}

headers {
  Accept: application/json
}

body:json {
  {
    "type": "schedule",
    "config": {
      "cron": "0 * * * *"
    },
    "is_active": true
  }
}

script:post-response {
  if (res.body?.data?.id) {
    bru.setVar("triggerId", res.body.data.id);
  }
}

docs {
  Creates a trigger for the agent. Either `type` (`webhook`, `schedule`, `manual`, or
  `polling`) or `trigger_type_key` (a key from the trigger type catalog) is required.
  A `schedule` trigger requires a valid `config.cron` expression; a `webhook` trigger
  may require `signing_secret` depending on the trigger type's signature scheme.
  Requires the `trigger.manage` permission.

  Expected result:
  - 201 with the created trigger.
  - 422 on validation errors (e.g. invalid cron expression, missing required config field).
  - 403 if the user lacks the `trigger.manage` permission.
  - 404 if the agent doesn't belong to this workspace.
}

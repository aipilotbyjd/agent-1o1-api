meta {
  name: List Agent Triggers
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/agents/:agent/triggers
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  agent: 1
}

headers {
  Accept: application/json
}

docs {
  Lists the agent's triggers, most recently created first. Requires the `trigger.view`
  permission.

  Expected result:
  - 200 with an array of triggers.
  - 403 if the user lacks the `trigger.view` permission.
  - 404 if the agent doesn't belong to this workspace.
}

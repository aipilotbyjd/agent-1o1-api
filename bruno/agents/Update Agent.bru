meta {
  name: Update Agent
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/agents/:agent
  body: json
  auth: inherit
}

params:path {
  workspace: 1
  agent: 1
}

headers {
  Accept: application/json
}

body:json {
  {
    "name": "Support Assistant",
    "description": "Handles first-line customer support questions.",
    "instructions": "You are a helpful customer support agent. Be concise, friendly, and escalate billing questions.",
    "provider": "anthropic",
    "model": "claude-sonnet-4-5",
    "temperature": 0.5,
    "settings": {}
  }
}

docs {
  Updates an agent. A new version is snapshotted only when a behavioral field changes
  (`instructions`, `provider`, `model`, `temperature`, `settings`) — renaming is cosmetic
  and does not create a version. Requires the `agent.manage` permission.

  Expected result:
  - 200 with the updated agent.
  - 422 on validation errors.
  - 403 if the user lacks the `agent.manage` permission.
  - 404 if the agent doesn't belong to this workspace.
}

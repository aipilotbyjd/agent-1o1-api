meta {
  name: Restore Agent Version
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/agents/:agent/versions/:version/restore
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  agent: 1
  version: 1
}

headers {
  Accept: application/json
}

docs {
  Restores the agent's `instructions`, `provider`, `model`, `temperature`, and `settings`
  from the given version, and re-attaches only the nodes from that snapshot that still
  exist in the workspace. This never rewrites history — the restore itself becomes the
  next version. Requires the `agent-version.manage` permission.

  Expected result:
  - 200 with the updated agent.
  - 403 if the user lacks the `agent-version.manage` permission.
  - 404 if the agent doesn't belong to this workspace, or the version doesn't exist.
}

meta {
  name: List Agent Versions
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/agents/:agent/versions
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  agent: 1
}

headers {
  Accept: application/json
}

docs {
  Lists the agent's versions, newest first. Requires the `agent-version.view`
  permission.

  Expected result:
  - 200 with an array of versions.
  - 403 if the user lacks the `agent-version.view` permission.
  - 404 if the agent doesn't belong to this workspace.
}

meta {
  name: Get Agent Version
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/agents/:agent/versions/:version
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  agent: 1
  version: 1
}

headers {
  Accept: application/json
}

docs {
  Retrieves a single version snapshot by its version number. Requires the
  `agent-version.view` permission.

  Expected result:
  - 200 with the version.
  - 403 if the user lacks the `agent-version.view` permission.
  - 404 if the agent doesn't belong to this workspace, or the version doesn't exist.
}

meta {
  name: Chat With Agent
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/agents/:agent/chat
  body: json
  auth: inherit
}

params:path {
  workspace: 1
  agent: 1
}

headers {
  Accept: application/json
}

body:json {
  {
    "message": "What's the status of my order?",
    "conversation_id": null
  }
}

docs {
  Sends a message to the agent and returns its reply. Omit `conversation_id` to start a
  new conversation, or pass a previous response's `conversation_id` to continue it.
  Requires the `agent.chat` permission.

  Expected result:
  - 200 with { reply, conversation_id, run_id }.
  - 422 on validation errors.
  - 403 if the user lacks the `agent.chat` permission.
  - 502 if the agent failed to respond (includes `run_id`).
}

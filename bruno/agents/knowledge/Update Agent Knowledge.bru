meta {
  name: Update Agent Knowledge
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/agents/:agent/knowledge/:knowledge
  body: json
  auth: inherit
}

params:path {
  workspace: 1
  agent: 1
  knowledge: 1
}

headers {
  Accept: application/json
}

body:json {
  {
    "title": "Refund Policy",
    "content": "Refunds are issued within 30 days of purchase upon request.",
    "is_active": true,
    "sort_order": 0
  }
}

docs {
  Updates a knowledge base entry. Requires the `agent-knowledge.manage` permission.

  Expected result:
  - 200 with the updated knowledge entry.
  - 422 on validation errors.
  - 403 if the user lacks the `agent-knowledge.manage` permission.
  - 404 if the knowledge entry doesn't belong to this agent.
}

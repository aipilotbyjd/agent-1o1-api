meta {
  name: List Agent Knowledge
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/agents/:agent/knowledge
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  agent: 1
}

headers {
  Accept: application/json
}

docs {
  Lists the agent's knowledge base entries, ordered by `sort_order`. Requires the
  `agent-knowledge.view` permission.

  Expected result:
  - 200 with an array of knowledge entries.
  - 403 if the user lacks the `agent-knowledge.view` permission.
  - 404 if the agent doesn't belong to this workspace.
}

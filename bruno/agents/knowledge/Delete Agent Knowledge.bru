meta {
  name: Delete Agent Knowledge
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/agents/:agent/knowledge/:knowledge
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  agent: 1
  knowledge: 1
}

headers {
  Accept: application/json
}

docs {
  Deletes a knowledge base entry. Requires the `agent-knowledge.manage` permission.

  Expected result:
  - 200 on success.
  - 403 if the user lacks the `agent-knowledge.manage` permission.
  - 404 if the knowledge entry doesn't belong to this agent.
}

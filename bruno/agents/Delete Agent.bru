meta {
  name: Delete Agent
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/agents/:agent
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  agent: 1
}

headers {
  Accept: application/json
}

docs {
  Deletes an agent. Requires the `agent.manage` permission.

  Expected result:
  - 200 on success.
  - 403 if the user lacks the `agent.manage` permission.
  - 404 if the agent doesn't belong to this workspace.
}

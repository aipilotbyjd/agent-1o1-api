meta {
  name: Create Agent Memory
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/agents/:agent/memories
  body: json
  auth: inherit
}

params:path {
  workspace: 1
  agent: 1
}

headers {
  Accept: application/json
}

body:json {
  {
    "key": "preferred_name",
    "value": "Ada",
    "type": "fact",
    "user_id": null,
    "metadata": {}
  }
}

docs {
  Creates a memory entry for the agent. Pass `user_id` to scope the memory to a specific
  user, or omit it for a workspace-wide memory. Requires the `agent-memory.manage`
  permission.

  Expected result:
  - 201 with the created memory entry.
  - 422 on validation errors (e.g. `user_id` doesn't exist).
  - 403 if the user lacks the `agent-memory.manage` permission.
  - 404 if the agent doesn't belong to this workspace.
}

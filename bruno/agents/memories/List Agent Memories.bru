meta {
  name: List Agent Memories
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/agents/:agent/memories
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  agent: 1
}

headers {
  Accept: application/json
}

docs {
  Lists the agent's memory entries, most recently created first. Requires the
  `agent-memory.view` permission.

  Expected result:
  - 200 with an array of memory entries.
  - 403 if the user lacks the `agent-memory.view` permission.
  - 404 if the agent doesn't belong to this workspace.
}

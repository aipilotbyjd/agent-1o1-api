meta {
  name: Update Agent Memory
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/agents/:agent/memories/:memory
  body: json
  auth: inherit
}

params:path {
  workspace: 1
  agent: 1
  memory: 1
}

headers {
  Accept: application/json
}

body:json {
  {
    "value": "Ada Lovelace"
  }
}

docs {
  Updates a memory entry. Requires the `agent-memory.manage` permission.

  Expected result:
  - 200 with the updated memory entry.
  - 422 on validation errors.
  - 403 if the user lacks the `agent-memory.manage` permission.
  - 404 if the memory entry doesn't belong to this agent.
}

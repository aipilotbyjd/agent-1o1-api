meta {
  name: List Agent Eval Runs
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/agents/:agent/eval-suites/:evalSuite/runs
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  agent: 1
  evalSuite: 1
}

headers {
  Accept: application/json
}

docs {
  Lists the evaluation runs for this suite, most recent first. Each run shows
  per-case pass/fail results. Requires the `agent-eval.view` permission.

  Expected result:
  - 200 with an array of eval runs.
  - 403 if the user lacks the `agent-eval.view` permission.
  - 404 if the eval suite doesn't belong to this agent.
}

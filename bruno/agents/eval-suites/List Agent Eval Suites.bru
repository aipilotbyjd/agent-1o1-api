meta {
  name: List Agent Eval Suites
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/agents/:agent/eval-suites
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  agent: 1
}

headers {
  Accept: application/json
}

docs {
  Lists the agent's evaluation suites, most recently created first. Requires the
  `agent-eval.view` permission.

  Expected result:
  - 200 with an array of eval suites.
  - 403 if the user lacks the `agent-eval.view` permission.
  - 404 if the agent doesn't belong to this workspace.
}

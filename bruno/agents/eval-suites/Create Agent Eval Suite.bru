meta {
  name: Create Agent Eval Suite
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/agents/:agent/eval-suites
  body: json
  auth: inherit
}

params:path {
  workspace: 1
  agent: 1
}

headers {
  Accept: application/json
}

body:json {
  {
    "name": "Customer Support Responses",
    "description": "Evaluates the agent's ability to handle common support scenarios.",
    "cases": [
      {
        "name": "Refund Request",
        "input": "I want a refund for my last payment.",
        "assertions": [
          {
            "type": "contains",
            "value": "refund"
          }
        ]
      }
    ]
  }
}

script:post-response {
  if (res.body?.data?.id) {
    bru.setVar("evalSuiteId", res.body.data.id);
  }
}

docs {
  Creates an evaluation suite for the agent, optionally with initial test cases.
  Cases can also be added afterwards via "Create Agent Eval Case". Requires the
  `agent-eval.manage` permission.

  Expected result:
  - 201 with the created eval suite, including cases.
  - 422 on validation errors.
  - 403 if the user lacks the `agent-eval.manage` permission.
  - 404 if the agent doesn't belong to this workspace.
}

meta {
  name: Forgot Password
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/password/forgot
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
    "email": "ada@example.com"
  }
}

docs {
  Sends a password reset link (pointed at FRONTEND_URL) if the email exists.

  Expected result:
  - 200 with the same generic message regardless of whether the email exists, to avoid
    leaking which emails are registered.
}

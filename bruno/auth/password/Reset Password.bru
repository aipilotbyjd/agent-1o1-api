meta {
  name: Reset Password
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/password/reset
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
    "email": "ada@example.com",
    "token": "5eedb1f6037b847cad1a32875fd1cf633a4acc276f49886e0084072c60cdb821",
    "password": "NewPassword123!",
    "password_confirmation": "NewPassword123!"
  }
}

docs {
  Resets the password using the token from the "Forgot Password" email link. Also revokes
  all of the user's existing tokens.
  
  Expected result:
  - 200 on success.
  - 422 if the token is invalid or expired.
}

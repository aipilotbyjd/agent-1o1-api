meta {
  name: Verify Email
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/auth/verify-email/:id/:hash
  body: none
  auth: none
}

params:path {
  id: 1
  hash: replace-with-sha1-of-email
}

headers {
  Accept: application/json
}

docs {
  Verifies a user's email via the signed link sent at registration. The full URL (with a
  valid `signature` query param) comes from the email — paste it into the Bruno URL bar
  directly rather than filling in id/hash by hand, since the signature won't validate
  otherwise.

  Expected result:
  - 200 on success.
  - 403 if the link is tampered with, expired, or the hash doesn't match.
}

meta {
  name: Get Authenticated User
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/user
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

vars:pre-request {
  baseUrl: http://agent-1o1-api.test
}

docs {
  Returns the currently authenticated user.
  
  Required variables:
  - baseUrl
  - token (Bearer access token from a Passport login)
  
  Expected result:
  - 200 with the user object.
  - 401 {"success": false, "message": "Unauthenticated."} when no/invalid token is sent.
}

meta {
  name: Resend Verification Email
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/auth/verify-email/resend
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

docs {
  Resends the verification email to the authenticated user, if not already verified.

  Expected result:
  - 200 either way (already verified, or a new email sent).
}

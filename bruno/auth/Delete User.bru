meta {
  name: Delete User
  type: http
  seq: 10
}

delete {
  url: {{baseUrl}}/api/v1/auth/user
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

docs {
  Deletes the authenticated user's account and revokes all of their tokens.

  Expected result:
  - 200 on success (the token used for this request is revoked too, so it can't be reused).
}

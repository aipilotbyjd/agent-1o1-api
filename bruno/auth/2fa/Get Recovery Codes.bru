meta {
  name: Get Recovery Codes
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/auth/2fa/recovery-codes
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

docs {
  Reports how many recovery codes remain unused. Codes are hashed at rest, so plaintext
  values are never returned here — only shown once, at confirm/regenerate time.

  Expected result:
  - 200 with { recovery_codes_remaining: <int> }.
}

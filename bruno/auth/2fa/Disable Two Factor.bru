meta {
  name: Disable Two Factor
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/2fa/disable
  body: json
  auth: inherit
}

headers {
  Accept: application/json
}

body:json {
  {
    "current_password": "Password123!"
  }
}

docs {
  Disables two-factor authentication after verifying the current password.

  Expected result:
  - 200 on success.
  - 422 if the password is wrong.
}

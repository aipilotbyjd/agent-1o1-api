meta {
  name: Confirm Two Factor
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/2fa/confirm
  body: json
  auth: inherit
}

headers {
  Accept: application/json
}

body:json {
  {
    "code": "123456"
  }
}

docs {
  Confirms 2FA setup with a valid TOTP code from the authenticator app, activating it.

  Expected result:
  - 200 with 8 one-time recovery_codes — store these, they are shown only once.
  - 422 if the code is invalid.
}

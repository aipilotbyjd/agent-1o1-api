meta {
  name: Enable Two Factor
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/2fa/enable
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

docs {
  Generates a new TOTP secret for the authenticated user (not yet active until confirmed).

  Expected result:
  - 200 with { secret, otpauth_url }. Scan otpauth_url with an authenticator app, or add it
    manually using the secret, then confirm with "Confirm Two Factor".
}

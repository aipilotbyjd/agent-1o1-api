meta {
  name: List Sessions
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/auth/sessions
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

docs {
  Lists the authenticated user's active Passport tokens ("sessions"), with the token used
  for this request flagged via is_current.

  Expected result:
  - 200 with an array of { id, client_name, created_at, expires_at, is_current }.
}

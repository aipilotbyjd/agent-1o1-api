meta {
  name: Revoke Session
  type: http
  seq: 2
}

delete {
  url: {{baseUrl}}/api/v1/auth/sessions/:id
  body: none
  auth: inherit
}

params:path {
  id: a278f95ce585fd9925664400081fc2f81dd1eb7af8bf4358ec83713558db7de73e89fefbec108981
}

headers {
  Accept: application/json
}

docs {
  Revokes a specific token by id (from "List Sessions"). Also revokes its refresh token.
  
  Expected result:
  - 200 on success.
  - 404 if the token doesn't exist or doesn't belong to the authenticated user.
}

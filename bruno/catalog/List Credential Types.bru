meta {
  name: List Credential Types
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/credential-types
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

docs {
  Lists all active credential types (e.g. `api_key`, `bearer_token`, `basic_auth`),
  ordered by sort order. Global, read-only catalog — not workspace-scoped, but still
  requires an authenticated + verified user.

  Expected result:
  - 200 with the list of credential types.
}

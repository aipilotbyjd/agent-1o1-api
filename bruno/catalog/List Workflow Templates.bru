meta {
  name: List Workflow Templates
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/workflow-templates
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

docs {
  Lists all active workflow templates, optionally filtered by `?category=`. Global,
  read-only catalog — not workspace-scoped, but still requires an authenticated +
  verified user.

  Expected result:
  - 200 with the list of workflow templates.
}

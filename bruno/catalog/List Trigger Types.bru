meta {
  name: List Trigger Types
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/trigger-types
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

docs {
  Lists all active trigger types, grouped by category. Global, read-only catalog —
  not workspace-scoped, but still requires an authenticated + verified user.

  Expected result:
  - 200 with trigger types grouped by category, each including key, name, description,
    mechanism, preset_config, and fields.
}

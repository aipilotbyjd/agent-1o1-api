meta {
  name: Update Credential
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/credentials/:credential
  body: json
  auth: inherit
}

params:path {
  workspace: 1
  credential: 1
}

headers {
  Accept: application/json
}

body:json {
  {
    "name": "Stripe API Key (rotated)",
    "data": {
      "value": "sk_test_new_placeholder"
    }
  }
}

docs {
  Updates a credential's name, data, and/or expiry. `type` cannot be changed after
  creation. No explicit permission check beyond workspace membership on this action.

  Expected result:
  - 200 with the updated credential.
  - 422 on validation errors.
  - 404 if the credential doesn't belong to this workspace.
}

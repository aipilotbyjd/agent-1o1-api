meta {
  name: Get Credential
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/credentials/:credential
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  credential: 1
}

headers {
  Accept: application/json
}

docs {
  Shows a single credential by id. Requires the `credential.view` permission.

  Expected result:
  - 200 with the credential.
  - 403 if the user lacks the `credential.view` permission.
  - 404 if the credential doesn't belong to this workspace.
}

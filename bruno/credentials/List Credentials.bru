meta {
  name: List Credentials
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/credentials
  body: none
  auth: inherit
}

params:path {
  workspace: 1
}

headers {
  Accept: application/json
}

docs {
  Lists all credentials in the workspace, most recent first. Requires the
  `credential.view` permission.

  Expected result:
  - 200 with the list of credentials.
  - 403 if the user lacks the `credential.view` permission.
}

meta {
  name: Delete Credential
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/credentials/:credential
  body: none
  auth: inherit
}

params:path {
  workspace: 1
  credential: 1
}

headers {
  Accept: application/json
}

docs {
  Deletes a credential. Requires the `credential.manage` permission.

  Expected result:
  - 200 on success.
  - 403 if the user lacks the `credential.manage` permission.
  - 404 if the credential doesn't belong to this workspace.
}

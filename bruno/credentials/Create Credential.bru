meta {
  name: Create Credential
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/workspaces/:workspace/credentials
  body: json
  auth: inherit
}

params:path {
  workspace: 1
}

headers {
  Accept: application/json
}

body:json {
  {
    "name": "Stripe API Key",
    "type": "api_key",
    "data": {
      "value": "sk_test_placeholder"
    },
    "expires_at": null
  }
}

docs {
  Creates a credential in the workspace. `type` must match an active key from
  "List Credential Types" (e.g. `api_key`, `bearer_token`, `basic_auth`); `data` shape
  depends on the chosen type's fields. Requires the `credential.manage` permission.

  Expected result:
  - 201 with the created credential.
  - 422 on validation errors (e.g. unknown `type`).
  - 403 if the user lacks the `credential.manage` permission.
}

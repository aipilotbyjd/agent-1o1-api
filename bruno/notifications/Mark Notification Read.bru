meta {
  name: Mark Notification Read
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/notifications/:notification/read
  body: none
  auth: inherit
}

params:path {
  notification: 9b1deb4d-3b7d-4bad-9bdd-2b0d7b3dcb6d
}

headers {
  Accept: application/json
}

docs {
  Marks a single notification as read. Not workspace-scoped; only matches
  notifications belonging to the authenticated user.

  Expected result:
  - 200 with the updated notification.
  - 404 if the notification doesn't belong to the authenticated user.
}
